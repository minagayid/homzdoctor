server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Set MAX_REQUEST_BODY_SIZE=25m on Cloud Run; the API's 24 MiB file limit leaves multipart overhead below the 32 MiB HTTP/1 request limit.
    client_max_body_size ${MAX_REQUEST_BODY_SIZE};

    # Resolve the backend host at request time (not at config load), so a
    # briefly-unavailable or not-yet-resolvable backend never crash-loops nginx.
    # NGINX_LOCAL_RESOLVERS is auto-populated from /etc/resolv.conf by the base
    # nginx image's docker-entrypoint.d/15-local-resolvers.sh.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        set $backend_host ${BACKEND_HOST};
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name $backend_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $backend_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
    }

    location /ws {
        set $backend_host ${BACKEND_HOST};
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_name $backend_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $backend_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
}
