# HomzDoctor Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://homzdoctor:password@localhost:5432/homzdoctor

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# AI/ML
MEDGEMMA_MODEL_PATH=./ml/models/medgemma

# --- Hugging Face (required for the two AI agents) ---
# Get a token at https://huggingface.co/settings/tokens (role: "Read" is enough).
HF_TOKEN=
# Text LLM — used by the Patient Assistant + Pharmacy agents.
HF_MODEL=Qwen/Qwen3-4B-Instruct
# Vision-language model (LVLM) — used by the imaging/lab diagnostic agent.
# Default is a general open VLM. For a medical-tuned model, request access to
# google/medgemma-4b-it on its model page, then set it here.
HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Optional: pin a specific inference provider (e.g. hf-inference, nebius,
# together). Leave blank for automatic selection.
HF_VLM_PROVIDER=
HF_TIMEOUT=120
# Optional limits for lab-report PDFs.
LVLM_MAX_PDF_PAGES=8
LVLM_PDF_DPI=150

# External APIs (optional)
# Enables LIVE nearby-pharmacy search (Places API). Without it, search ranks
# the pharmacies already in your database by distance.
# Get one at https://console.cloud.google.com/ (enable "Places API").
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_URL=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB
