# Copy this file to backend/.env for a local run.
ENVIRONMENT=local
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Replace this before exposing the server beyond localhost.
SECRET_KEY=change-this-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local-first persistence. Relative paths are anchored to backend/.
DATABASE_URL=sqlite+aiosqlite:///./homzdoctor.db
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600
SEED_DEMO_DATA=true

# Browser access for the local Vite development server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional local OpenAI-compatible server. Leave blank for deterministic
# offline responses. Example: Ollama/vLLM/llama.cpp serving gpt-oss.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=gpt-oss-20b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=30

# Optional hosted/model integrations; they are not needed for local use.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct
HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
GOOGLE_MAPS_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=homzdoctor_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
