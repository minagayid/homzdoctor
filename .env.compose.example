POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
ALLOWED_ORIGINS=https://your-domain.example
WEB_PORT=3000
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct
HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
